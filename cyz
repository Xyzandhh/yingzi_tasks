<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>陈樱姿 · 个人简介</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230e9d8c'/%3E%3Ccircle cx='12' cy='16' r='2.4' fill='%23fff'/%3E%3Ccircle cx='20' cy='16' r='2.4' fill='%23fff'/%3E%3C/svg%3E">
<style>
:root{
  --bg:#0b1419;
  --card:#111f26;
  --card-2:#152830;
  --line:rgba(255,255,255,.08);
  --line-soft:rgba(255,255,255,.05);
  --ink:#e8f0f2;
  --text:#b8c8cf;
  --muted:#7d949d;
  --accent:#2dd4bf;
  --accent-soft:rgba(45,212,191,.1);
  --accent-border:rgba(45,212,191,.28);
  --chip-bg:rgba(255,255,255,.04);
}
*{margin:0;padding:0;box-sizing:border-box;}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth;}
body{
  font-family:"Noto Sans SC","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.85;
  font-size:15px;
  -webkit-font-smoothing:antialiased;
}
.page{max-width:780px;margin:0 auto;padding:40px 20px 64px;}

/* ===== 顶部 Hero ===== */
.hero{
  position:relative;
  background:linear-gradient(160deg,#10242c 0%,#0b161b 100%);
  border:1px solid var(--line);
  border-radius:22px;
  padding:52px 48px 44px;
  margin-bottom:22px;
  overflow:hidden;
  color:var(--ink);
}
.hero::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background-image:
    linear-gradient(rgba(45,212,191,.07) 1px,transparent 1px),
    linear-gradient(90deg,rgba(45,212,191,.07) 1px,transparent 1px);
  background-size:34px 34px;
  -webkit-mask-image:radial-gradient(ellipse 90% 80% at 30% 20%,#000 20%,transparent 75%);
          mask-image:radial-gradient(ellipse 90% 80% at 30% 20%,#000 20%,transparent 75%);
}
.hero-inner{position:relative;z-index:1;}

/* 小智能体 */
.agent{
  width:74px;height:74px;border-radius:20px;
  background:linear-gradient(135deg,#16303a,#0e2028);
  border:1.5px solid var(--accent-border);
  display:flex;align-items:center;justify-content:center;
  gap:14px;margin-bottom:26px;
  box-shadow:0 10px 30px rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.06);
}
.eye{width:16px;height:16px;border-radius:50%;background:#1d3a42;display:flex;align-items:center;justify-content:center;}
.pupil{width:8px;height:8px;border-radius:50%;background:var(--accent);transition:transform .12s ease-out;box-shadow:0 0 8px rgba(45,212,191,.7);}

.greet{font-size:13px;color:var(--accent);letter-spacing:3px;font-weight:500;margin-bottom:8px;font-family:"JetBrains Mono",ui-monospace,monospace;}
.name{font-size:46px;font-weight:900;color:#fff;letter-spacing:2px;line-height:1.15;}
.role{margin-top:10px;font-size:15px;color:var(--muted);letter-spacing:1px;}
.role b{color:var(--accent);font-weight:600;}

/* 终端 */
.terminal{
  margin-top:30px;
  background:rgba(0,0,0,.4);
  border:1px solid var(--line);
  border-radius:12px;overflow:hidden;
  font-family:"JetBrains Mono",ui-monospace,Menlo,Consolas,monospace;
}
.term-bar{display:flex;align-items:center;gap:7px;padding:10px 14px;background:rgba(255,255,255,.04);border-bottom:1px solid var(--line);}
.dot-r{width:11px;height:11px;border-radius:50%;background:#ff5f57;}
.dot-y{width:11px;height:11px;border-radius:50%;background:#febc2e;}
.dot-g{width:11px;height:11px;border-radius:50%;background:#28c840;}
.term-title{margin-left:8px;font-size:12px;color:var(--muted);}
.term-body{padding:16px 18px;font-size:13.5px;line-height:2;}
.term-body .p{color:var(--accent);}
.term-body .cmd{color:var(--ink);}
.term-body .out{color:var(--muted);}
.term-body .hl{color:var(--accent);}
.cursor{display:inline-block;width:8px;height:15px;background:var(--accent);vertical-align:-2px;margin-left:2px;animation:blink 1.1s steps(1) infinite;}
@keyframes blink{50%{opacity:0;}}

.tags{margin-top:26px;display:flex;flex-wrap:wrap;gap:8px;}
.tag{font-size:12.5px;color:var(--accent);background:var(--accent-soft);border:1px solid var(--accent-border);border-radius:999px;padding:4px 14px;letter-spacing:1px;}

/* ===== 内容卡片（统一深色） ===== */
.section{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:30px 44px;
  margin-bottom:20px;
  transition:border-color .25s ease, transform .25s ease;
}
.section:hover{border-color:var(--accent-border);}
.section-head{display:flex;align-items:center;gap:11px;margin-bottom:18px;}
.section-head .ic{
  width:34px;height:34px;border-radius:9px;
  background:var(--accent-soft);border:1px solid var(--accent-border);
  color:var(--accent);display:flex;align-items:center;justify-content:center;flex:none;
}
.section-head .ic svg{width:18px;height:18px;}
.section-head h2{font-size:18px;font-weight:700;color:var(--ink);letter-spacing:.5px;}
.section-head .en{margin-left:auto;font-size:11px;color:var(--muted);letter-spacing:2px;font-family:"JetBrains Mono",ui-monospace,monospace;}

/* 技术方向 */
.dir-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 22px;}
.dir-item{display:flex;gap:11px;align-items:flex-start;font-size:14px;color:var(--text);padding:10px 12px;border-radius:10px;transition:background .2s;}
.dir-item:hover{background:var(--card-2);}
.dir-item .num{flex:none;font-family:"JetBrains Mono",monospace;font-size:12px;font-weight:600;color:var(--accent);padding-top:3px;}

/* 技能 */
.tech-row{display:grid;grid-template-columns:110px 1fr;gap:6px 18px;padding:10px 0;align-items:start;}
.tech-row + .tech-row{border-top:1px dashed var(--line-soft);}
.tech-label{font-size:13.5px;font-weight:700;color:var(--ink);padding-top:4px;}
.tech-value{font-size:13.5px;}
.tech-value code{
  font-family:"JetBrains Mono",ui-monospace,monospace;
  font-size:12.5px;background:var(--chip-bg);
  border:1px solid var(--line);border-radius:6px;
  padding:2px 9px;margin:0 5px 6px 0;display:inline-block;color:var(--text);
  transition:border-color .2s,color .2s;
}
.tech-value code:hover{border-color:var(--accent);color:var(--accent);}

/* 代表作品 */
.project{padding:20px 0 20px 22px;border-left:3px solid var(--accent);}
.project + .project{border-top:1px solid var(--line-soft);}
.project h3{font-size:16px;font-weight:700;color:var(--ink);}
.project .sub{font-size:12.5px;color:var(--accent);margin:4px 0 10px;letter-spacing:1px;font-family:"JetBrains Mono",ui-monospace,monospace;}
.project p{font-size:14px;margin-bottom:8px;}
.project ul{list-style:none;}
.project li{font-size:13.5px;padding-left:16px;position:relative;margin:3px 0;}
.project li::before{content:"";position:absolute;left:2px;top:10px;width:6px;height:6px;border-radius:50%;background:transparent;border:1.5px solid var(--accent);}
.project .note{margin-top:10px;font-size:13px;color:var(--muted);}
.project strong{color:var(--accent);}

/* 页脚 */
.footer{text-align:center;padding-top:28px;color:var(--muted);font-size:13px;letter-spacing:3px;}
.footer .line{width:56px;height:2px;background:var(--accent);margin:0 auto 16px;border-radius:2px;}

@media (max-width:560px){
  .page{padding:20px 12px 40px;}
  .hero{padding:36px 26px 32px;border-radius:16px;}
  .name{font-size:34px;}
  .section{padding:24px 22px;border-radius:12px;}
  .dir-grid{grid-template-columns:1fr;}
  .tech-row{grid-template-columns:1fr;gap:2px;}
  .tag{font-size:13px;}
  .tech-value code{font-size:13px;padding:3px 10px;}
  .project li{font-size:14px;}
}
@media (prefers-reduced-motion:reduce){
  .cursor{animation:none;}
  *{transition:none !important;}
}
</style>
</head>
